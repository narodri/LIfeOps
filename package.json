{
  "name": "lifeops",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:web": "npm --workspace @lifeops/web run dev",
    "dev:api": "npm --workspace @lifeops/api run dev",
    "build": "npm run build -ws",
    "typecheck": "npm run typecheck -ws",
    "test": "npm run test -ws"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
